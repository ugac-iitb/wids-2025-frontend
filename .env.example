# ==============================================================================
# WiDS Frontend - Environment Configuration Example
# Copy this file to .env.local for local development, or configure in deployment
# ==============================================================================

# Mode toggle: Set to true for local development, false for production
NEXT_PUBLIC_DEBUG=true

# Django Backend API Base URL
# Local development default:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/apis-wids2025
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/apis-wids2025

# Production server example:
# NEXT_PUBLIC_API_URL=https://ugac.gymkhana.iitb.ac.in/apis-wids2025
# NEXT_PUBLIC_API_BASE_URL=https://ugac.gymkhana.iitb.ac.in/apis-wids2025

# IIT Bombay Gymkhana SSO OAuth2 Credentials
# The Client ID registered on https://gymkhana.iitb.ac.in/profiles
NEXT_PUBLIC_CLIENT_ID=your_sso_client_id_here

# OAuth2 Redirect URI (Must match EXACTLY one of the registered URIs on Gymkhana SSO)
# Note: Next.js has basePath "/wids-2025", so local dev uses:
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/wids-2025/process-login/

# Production redirect URI example:
# NEXT_PUBLIC_REDIRECT_URI=https://ugac.gymkhana.iitb.ac.in/wids-2025/process-login/
